{
  "name": "@0xmaxma/jev-loop",
  "version": "0.2.0",
  "description": "Jev Loop MCP for agents with reusable decision logic and Thinking Module",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./thinking": {
      "types": "./thinking.d.ts",
      "default": "./thinking.cjs"
    },
    "./mcp": {
      "types": "./mcp.d.ts",
      "default": "./mcp.cjs"
    },
    "./browser-use": {
      "types": "./dist/browser-use.d.ts",
      "default": "./dist/browser-use.js"
    },
    "./computer-use": {
      "types": "./dist/computer-use.d.ts",
      "default": "./dist/computer-use.js"
    },
    "./tasks": {
      "types": "./task-mcp.d.ts",
      "default": "./task-mcp.cjs"
    }
  },
  "files": [
    "*.cjs",
    "*.d.ts",
    "README.md",
    "dist/",
    "logic/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.cjs test/*.test.ts",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xMaxMa/jev-loop.git"
  },
  "private": false,
  "bin": {
    "jev-loop-mcp": "cli.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  }
}
